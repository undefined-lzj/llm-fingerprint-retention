{
  "schema_version": 1,
  "phase": "P2",
  "seed": 42,
  "data_seed": 42,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_bias": "none",
  "task_type": "CAUSAL_LM",
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "learning_rate": 0.0002,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "max_steps": 80,
  "warmup_steps": 5,
  "weight_decay": 0.0,
  "max_grad_norm": 1.0,
  "bf16": true,
  "gradient_checkpointing": false,
  "logging_steps": 1,
  "save_strategy": "no",
  "report_to": "none",
  "max_sequence_length": 256,
  "evaluation_max_new_tokens": 16,
  "evaluation_repeats": 2,
  "evaluation_do_sample": false,
  "system_prompt": null
}
